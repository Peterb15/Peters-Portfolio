---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
/** Click-to-load game embed: nothing heavy downloads until the visitor presses Play. */
interface Props { src: string; title: string; poster?: ImageMetadata; ratio?: string; note?: string; size?: string }
const { src, title, poster, ratio = '16/9', note, size } = Astro.props;
const posterUrl = poster ? (await getImage({ src: poster, width: 1400, format: 'jpeg' })).src : undefined;
---
<figure class="play">
  <div class="stage" style={`aspect-ratio:${ratio}`} data-play={src} data-title={title}>
    {posterUrl && <img src={posterUrl} alt="" />}
    <button type="button" class="go"><span class="tri">▶</span> Play {title}</button>
    {size && <span class="size mono">{size} · loads when you press play</span>}
  </div>
  <figcaption class="mono soft">
    <span>{note}</span>
    <a href={src} target="_blank" rel="noopener">Open full screen ↗</a>
  </figcaption>
</figure>
<script>
  document.querySelectorAll<HTMLElement>('[data-play]').forEach((stage) => {
    stage.querySelector('.go')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = stage.dataset.play || '';
      f.title = stage.dataset.title || 'Game';
      f.allow = 'autoplay; fullscreen; gamepad';
      f.setAttribute('allowfullscreen', '');
      stage.replaceChildren(f);
      f.focus();
    });
  });
</script>
<style>
  .play { margin: 0; display: flex; flex-direction: column; gap: 6px; }
  .stage { position: relative; border: 1.5px solid var(--ink); background: #000; overflow: hidden; display: grid; place-items: center; max-width: 100%; }
  .stage img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .55; }
  .stage :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .go {
    position: relative; z-index: 1; background: var(--p); color: var(--p-ink); border: 0; cursor: pointer;
    font-family: var(--font-display); font-weight: 900; text-transform: uppercase; font-size: clamp(1.4rem, 3vw, 2.4rem);
    padding: 12px 24px; box-shadow: 0 0 0 4px var(--paper), 0 0 0 5.5px var(--ink); transition: transform .2s var(--ease);
  }
  .go:hover { transform: scale(1.05); }
  .tri { font-size: .8em; }
  .size { position: absolute; bottom: 10px; left: 12px; color: #fbfaf6; z-index: 1; }
  figcaption { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
</style>
