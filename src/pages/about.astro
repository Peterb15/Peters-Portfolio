---
import Base from '../layouts/Base.astro';
---
<Base title="About" description="Peter Burke: creative technologist and storyteller.">
  <section class="about">
    <div class="portrait">
      <span class="mono soft">Photo coming. Workshop or on set.</span>
    </div>
    <div class="copy">
      <span class="mono soft">About</span>
      <h1>Peter Burke <span class="light">builds the thing, and tells you its story.</span></h1>
      <p>I'm a creative technologist and storyteller with a dual degree from CU Boulder in Creative Technology &amp; Design and English (Creative Writing). I direct animation, wire hardware, fabricate sets and build worlds people want to walk into, whether that's a punk musician who robs banks or an ocean of broken islands.</p>
      <p>I'm happiest when a project needs all of it: something physical to build, a technical problem to solve, and a story it all has to serve. That's why I'm aiming for themed entertainment, animation and freelance work that doesn't fit in one box.</p>
      <p>Off the clock: worldbuilder, fiction writer, tabletop RPGs, punk aesthetics, and stories that trust their audience to keep up.</p>
      <dl class="skills">
        <div><dt class="mono">Animation</dt><dd class="mono soft">Blender · rigging · cel-shading · sculpting</dd></div>
        <div><dt class="mono">Fabrication</dt><dd class="mono soft">Woodworking · 3D print · laser · set build</dd></div>
        <div><dt class="mono">Hardware</dt><dd class="mono soft">Arduino · ESP32 · sensors</dd></div>
        <div><dt class="mono">Programming</dt><dd class="mono soft">C++ · JavaScript · GDScript · Ink</dd></div>
        <div><dt class="mono">Narrative</dt><dd class="mono soft">Worlds · scripts · directing</dd></div>
      </dl>
    </div>
  </section>
</Base>
<style>
  .about { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(24px, 4vw, 56px); padding: 40px var(--gutter) 0; max-width: 1280px; margin: 0 auto; align-items: start; }
  @media (max-width: 760px) { .about { grid-template-columns: 1fr; } }
  .portrait { aspect-ratio: 4 / 5; border: 1.5px solid var(--ink); background: repeating-linear-gradient(-45deg, rgba(11,11,12,.07) 0 8px, transparent 8px 16px), var(--paper-2); display: grid; place-items: center; transform: rotate(-2deg); padding: 16px; text-align: center; }
  .copy { display: flex; flex-direction: column; gap: 18px; }
  h1 { font-size: clamp(2.6rem, 6vw, 4.6rem); }
  .copy p { max-width: 62ch; font-size: 1.1rem; }
  .skills { margin: 8px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); border-top: 1.5px solid var(--ink); }
  .skills div { padding: 10px 12px 10px 0; border-bottom: 1px solid var(--rule); display: flex; flex-direction: column; gap: 2px; }
  .skills dd { margin: 0; }
</style>
