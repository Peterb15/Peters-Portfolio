---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  img: ImageMetadata;
  alt: string;
  caption?: string;
  /** figure label shown at the right of the caption, e.g. "Fig. 03" */
  num?: string;
  /** a marker-pen note over the image */
  mark?: string;
  markAt?: 'tl' | 'tr' | 'bl' | 'br';
  ratio?: string;
  fit?: 'cover' | 'contain';
  widths?: number[];
}
const { img, alt, caption, num, mark, markAt = 'tl', ratio, fit = 'cover', widths = [480, 800, 1200, 1800] } = Astro.props;
---
<figure class="fig">
  <div class:list={['frame', fit]} style={ratio ? `aspect-ratio:${ratio}` : undefined}>
    <Image src={img} alt={alt} widths={widths} sizes="(max-width: 760px) 100vw, 60vw" loading="lazy" />
    {mark && <span class:list={['mark', markAt]} set:html={mark} />}
  </div>
  {(caption || num) && (
    <figcaption class="mono soft"><span>{caption}</span>{num && <span>{num}</span>}</figcaption>
  )}
</figure>
<style>
  .fig { margin: 0; display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .frame { position: relative; overflow: hidden; border: 1.5px solid var(--ink); background: var(--paper-2); }
  .frame :global(img) { width: 100%; height: 100%; }
  .cover :global(img) { object-fit: cover; }
  .contain :global(img) { object-fit: contain; }
  .frame[style] :global(img) { position: absolute; inset: 0; }
  figcaption { display: flex; justify-content: space-between; gap: 12px; }
  .mark.tl { left: 4%; top: 6%; } .mark.tr { right: 4%; top: 6%; transform: rotate(4deg); }
  .mark.bl { left: 4%; bottom: 7%; } .mark.br { right: 4%; bottom: 7%; transform: rotate(3deg); }
</style>
