---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { cards: { img: ImageMetadata; alt: string }[]; back?: ImageMetadata; caption?: string }
const { cards, back, caption } = Astro.props;
const mid = (cards.length - 1) / 2;
---
<figure class="cards-fig">
  <div class="cards">
    {cards.map((c, i) => (
      <button type="button" class="card" aria-label={`${c.alt}: flip`} style={`--r:${(i - mid) * 7}deg;--y:${Math.abs(i - mid) * 10}px`}>
        <span class="inner">
          <Image class="face front" src={c.img} alt={c.alt} widths={[240, 400]} sizes="180px" loading="lazy" />
          {back && <Image class="face back" src={back} alt="Card back" widths={[240, 400]} sizes="180px" loading="lazy" />}
        </span>
      </button>
    ))}
  </div>
  {caption && <figcaption class="mono soft">{caption}</figcaption>}
</figure>
<script>
  // tap to flip on touch screens (hover handles desktop)
  document.querySelectorAll<HTMLButtonElement>('.cards .card').forEach((c) => c.addEventListener('click', () => c.classList.toggle('flipped')));
</script>
<style>
  .cards-fig { margin: 0; display: flex; flex-direction: column; gap: 10px; align-items: center; }
  .cards { display: flex; justify-content: center; padding: 18px 0 26px; perspective: 1200px; }
  .card {
    width: clamp(92px, 17vw, 180px); aspect-ratio: 5 / 7; margin-inline: -12px; padding: 0; border: 0; background: none; cursor: pointer;
    transform: rotate(var(--r)) translateY(var(--y)); transition: transform .35s var(--ease);
  }
  .inner { position: relative; display: block; width: 100%; height: 100%; transform-style: preserve-3d; transition: transform .6s var(--ease); }
  .card :global(.face) {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border: 1.5px solid var(--ink); background: #fff;
    box-shadow: 0 12px 24px rgba(11, 11, 12, .16); backface-visibility: hidden; -webkit-backface-visibility: hidden;
  }
  .card :global(.back) { transform: rotateY(180deg); }
  .card:hover, .card:focus-visible { transform: rotate(0) translateY(-16px) scale(1.07); z-index: 2; }
  .card:hover .inner, .card:focus-visible .inner, .card.flipped .inner { transform: rotateY(180deg); }
  @media (prefers-reduced-motion: reduce) { .inner { transition: none; } }
</style>
