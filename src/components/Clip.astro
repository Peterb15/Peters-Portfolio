---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: string; poster?: ImageMetadata; caption?: string; ratio?: string; sound?: boolean; autoplay?: boolean; maxWidth?: string }
const { src, poster, caption, ratio = '16/9', sound = false, autoplay = true, maxWidth } = Astro.props;
const posterUrl = poster ? (await getImage({ src: poster, width: 1280, format: 'jpeg' })).src : undefined;
---
<figure class="clip" style={maxWidth ? `max-width:${maxWidth}` : undefined}>
  <div class="frame" style={`aspect-ratio:${ratio}`}>
    <video src={src} poster={posterUrl} muted loop playsinline preload={autoplay ? 'metadata' : 'none'} autoplay={autoplay} data-clip></video>
    {sound && <button type="button" class="snd" data-sound aria-pressed="false">▶ Sound on</button>}
  </div>
  {caption && <figcaption class="mono soft">{caption}</figcaption>}
</figure>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-sound]').forEach((btn) => {
    const v = btn.parentElement?.querySelector('video');
    if (!v) return;
    btn.addEventListener('click', () => {
      v.muted = !v.muted;
      if (!v.muted) { v.currentTime = 0; v.play().catch(() => {}); }
      btn.setAttribute('aria-pressed', String(!v.muted));
      btn.textContent = v.muted ? '▶ Sound on' : '■ Sound off';
    });
  });
  // pause offscreen clips
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    const v = e.target as HTMLVideoElement;
    if (e.isIntersecting) { if (v.autoplay || v.dataset.played) v.play().catch(() => {}); } else if (!v.paused) { v.dataset.played = '1'; v.pause(); }
  }), { threshold: .2 });
  document.querySelectorAll<HTMLVideoElement>('[data-clip]').forEach((v) => io.observe(v));
</script>
<style>
  .clip { margin: 0; display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .frame { position: relative; border: 1.5px solid var(--ink); background: var(--ink); overflow: hidden; max-width: 100%; }
  video { width: 100%; height: 100%; object-fit: cover; }
  .snd {
    position: absolute; right: 12px; bottom: 12px; background: var(--p); color: var(--p-ink); border: 0;
    font-family: var(--font-display); font-weight: 900; text-transform: uppercase; font-size: 1.15rem; padding: 6px 14px; cursor: pointer;
    box-shadow: 0 0 0 3px var(--paper), 0 0 0 4.5px var(--ink);
  }
</style>
